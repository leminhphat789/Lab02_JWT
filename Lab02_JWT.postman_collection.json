            "exec": [
              "(() => {",
              "pm.variables.set(\"wrongPasswordBase64\",require(\"btoa\")(\"wrong-password\"));",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Wrong password rejected\",()=>pm.expect(pm.response.json().error).to.eql(\"INVALID_CREDENTIALS\"));",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{wrongPasswordBase64}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    }
